pragma language_version 0.23;

import CompactStandardLibrary;

// One deployment is one electorate. The organizer registers voter commitments,
// seals the roll, then opens proposals one at a time. A voter proves membership
// in the sealed roll with a private Merkle path and publishes a nullifier that is
// scoped to the proposal, so the same voter can vote once on every proposal and
// the votes on different proposals cannot be linked to each other.

export enum Phase { registration, idle, voting }

export ledger electionId: Bytes<32>;
export ledger organizer: Bytes<32>;
export ledger phase: Phase;
export ledger voters: MerkleTree<10, Bytes<32>>;
export ledger registered: Set<Bytes<32>>;
export ledger activeProposal: Bytes<32>;
export ledger proposals: Set<Bytes<32>>;
export ledger nullifiers: Set<Bytes<32>>;
export ledger yesVotes: Map<Bytes<32>, Counter>;
export ledger noVotes: Map<Bytes<32>, Counter>;

witness organizerSecret(): Bytes<32>;
witness voterSecret(): Bytes<32>;
witness membershipPath(leaf: Bytes<32>): MerkleTreePath<10, Bytes<32>>;

constructor(id: Bytes<32>, authority: Bytes<32>) {
  electionId = disclose(id);
  organizer = disclose(authority);
  phase = Phase.registration;
}

export pure circuit organizerCommitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "nightvote:organizer:v1"), secret]);
}

export pure circuit voterCommitment(election: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "nightvote:voter:v1"), election, secret]);
}

export pure circuit voteNullifier(election: Bytes<32>, proposal: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "nightvote:nullifier:v1"), election, proposal, secret]);
}

circuit requireOrganizer(): [] {
  assert(organizerCommitment(organizerSecret()) == organizer, "Organizer authorization required");
}

export circuit registerVoter(commitment: Bytes<32>): [] {
  requireOrganizer();
  assert(phase == Phase.registration, "Voter registration is closed");
  assert(!registered.member(disclose(commitment)), "Voter already registered");
  voters.insert(disclose(commitment));
  registered.insert(disclose(commitment));
}

export circuit closeRegistration(): [] {
  requireOrganizer();
  assert(phase == Phase.registration, "Voter registration is already closed");
  assert(registered.size() > 0, "Register at least one voter first");
  phase = Phase.idle;
}

export circuit openProposal(proposal: Bytes<32>): [] {
  requireOrganizer();
  assert(phase != Phase.registration, "Close voter registration before opening a proposal");
  assert(phase != Phase.voting, "Another proposal is already active");
  assert(!proposals.member(disclose(proposal)), "Proposal was already used");
  proposals.insert(disclose(proposal));
  yesVotes.insertDefault(disclose(proposal));
  noVotes.insertDefault(disclose(proposal));
  activeProposal = disclose(proposal);
  phase = Phase.voting;
}

export circuit closeProposal(): [] {
  requireOrganizer();
  assert(phase == Phase.voting, "No proposal is active");
  phase = Phase.idle;
}

export circuit castVote(proposal: Bytes<32>, inFavor: Boolean): Bytes<32> {
  // The caller names the proposal it intends to vote on; a vote can never land
  // on a proposal the voter did not see.
  assert(phase == Phase.voting, "No proposal is active");
  assert(disclose(proposal) == activeProposal, "Proposal is not active");
  const secret = voterSecret();
  const leaf = voterCommitment(electionId, secret);
  const path = membershipPath(leaf);
  // Witness implementations are untrusted. Bind the path to the actual secret.
  assert(path.leaf == leaf, "Membership path does not match voter");
  assert(voters.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))), "Voter is not on the electoral roll");
  const nullifier = voteNullifier(electionId, activeProposal, secret);
  assert(!nullifiers.member(disclose(nullifier)), "Already voted on this proposal");
  nullifiers.insert(disclose(nullifier));
  if (disclose(inFavor)) {
    yesVotes.lookup(activeProposal).increment(1);
  } else {
    noVotes.lookup(activeProposal).increment(1);
  }
  return disclose(nullifier);
}
